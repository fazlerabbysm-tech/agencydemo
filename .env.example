# ==================== KATELLA DIGITAL ENV CONFIG ====================
# Copy these keys into Vercel Project Settings -> Environment Variables

# --- Admin Dashboard Security ---
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-hex-secret-here
CRON_SECRET=generate-another-random-secret-for-vercel-cron

# --- Persistent Cloud Storage (Upstash Redis / Vercel KV — Free Tier) ---
# Connect Upstash Redis free tier in Vercel Marketplace (500k commands/month free)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Dual Email APIs (Verified Domain Senders: Brevo 300/day + Resend 100/day = 400/day) ---
BREVO_API_KEY=
RESEND_API_KEY=

# --- Verified Domain Sender & Company Inbox ---
SENDER_NAME=Katella Digital
SENDER_EMAIL=info@katelladigital.com
CONTACT_EMAIL=info@katelladigital.com

# --- Cloudflare Turnstile (Optional Spam Protection on Contact Form) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site Base URL (Used for Unsubscribe links in outreach emails) ---
NEXT_PUBLIC_SITE_URL=https://katelladigital.com
