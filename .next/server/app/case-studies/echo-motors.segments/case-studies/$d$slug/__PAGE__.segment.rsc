0:{"buildId":"PTWSWFlPIbEhrOk_o-gY1","rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"caseStudy":{"slug":"echo-motors","title":"ECHO Motors: $280K saved with CGI launch","clientLogo":"/images/casestudy-echo-logo.png","clientName":"ECHO Motors","metrics":[{"label":"Cost savings","value":"$$280K"},{"label":"Time to launch","value":"8 weeks"},{"label":"Physical shoots","value":"0"},{"label":"3D assets reusable","value":"100%"}],"ctaSticky":"Get results like this","snapshot":{"client":"ECHO Motors","industry":"Automotive / EV","services":["Virtual Production & CGI Studio","Color Standardization Protocol"],"timeline":"8 weeks · 2024"},"serviceSlug":"cgi","challengeTitle":"A car launch with no car to film","challengeText":["ECHO Motors was launching their first electric vehicle, but the physical prototype wasn't ready. The marketing team had 8 weeks to produce a launch film, and there was no car to film.","Traditional production would mean waiting months for the prototype, then scheduling a shoot with a crew, location, permits, and weather risk. The launch date was locked — there was no flexibility.","Their competitor had just launched with a cinematic film shot in Iceland. ECHO needed something that looked just as premium, without the physical production."],"challengeImage":"/images/casestudy-echo-challenge.jpg","approachTitle":"Build the car in pixels, shoot in virtual","approachText":["We built the entire car in CGI — a photoreal 3D model with every detail, from the headlights to the stitching on the seats. The model was based on CAD files from the engineering team, so it was dimensionally accurate.","Using our LED volume virtual production stage, we shot real-time environments: desert highways, city nights, mountain passes. The car was composited into every scene in real-time, so the director could see the final shot on set.","The key decision was to use Unreal Engine for real-time rendering instead of offline. This let us iterate on lighting and camera angles on the day of the shoot, instead of waiting for overnight renders."],"approachImage":"/images/casestudy-echo-approach.jpg","shippedTitle":"What we shipped","shippedIntro":"A full CGI launch film, virtual production day, and all 3D assets — reusable for future campaigns, AR, and the website configurator.","shipItems":[{"title":"Photoreal CGI car","desc":"A 3D model built from CAD files — dimensionally accurate, with every material and texture.","image":"/images/casestudy-echo-ship-1.jpg"},{"title":"Virtual production film","desc":"A 60-second launch film shot on our LED volume — desert, city, and mountain environments.","image":"/images/casestudy-echo-ship-2.jpg"},{"title":"3D asset library","desc":"All models, textures, and scene files handed off for future campaigns and AR/VR experiences.","image":"/images/casestudy-echo-ship-3.jpg"}],"liveProjectUrl":"https://echomotors.example.com","resultsTitle":"The numbers, before and after","resultsMetrics":[{"label":"Production cost","value":"$$460K → $180K"},{"label":"Time to launch","value":"16 wks → 8 wks"},{"label":"Weather risk","value":"100% → 0%"},{"label":"Asset reuse","value":"0 → 6 campaigns"}],"resultsImage":"/images/casestudy-echo-results.jpg","testimonial":{"quote":"We launched the new EV with a full CGI film — no physical car, no location, no weather risk. It cost 60% less than the planned shoot and looked better than anything we could have filmed. The 3D assets are now used in every campaign.","name":"Daniel Park","role":"Marketing Director, ECHO Motors"},"learningsTitle":"What we'd repeat or change","learningsText":["We'd repeat the real-time Unreal Engine approach. Being able to iterate on lighting and camera angles on the day of the shoot — instead of waiting for overnight renders — saved at least a week.","We'd involve the engineering team earlier. The CAD files were accurate but needed cleanup for CGI. A 2-day workshop with engineering before the build would have saved 4 days of rework."],"servicesUsed":["Virtual Production & CGI Studio","Color Standardization Protocol"],"relatedTitle":"Related case studies","ctaTitle":"Want results like this?"}}]}],["$L4"],"$L5"]}],"loading":null,"isPartial":false}
