0:{"buildId":"PTWSWFlPIbEhrOk_o-gY1","rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"service":{"slug":"motion-graphics","no":"02","name":"Motion Graphics","heroTitle":"Stories that move.","heroOutcome":"We create motion graphics that capture attention in the first 3 seconds. Brand films, social ads, explainer videos, and product animations — every frame designed to stop the scroll and drive action.","bestFor":[" Brands launching campaigns","SaaS companies","Social media teams"],"notSureText":"Not sure it fits? Talk to us","problemTitle":"Your content doesn't stop the scroll","problemPoints":["Your social posts get lost in the feed within seconds","Static images don't communicate your product's value","You need video but don't have a production team","Your explainer videos look dated and amateur","Ad fatigue is killing your campaign performance"],"problemImage":"/images/detail-color-problem.jpg","includedTitle":"What's included","subServices":[{"title":"Brand Films","desc":"30–90 second cinematic brand stories that define who you are and why you matter.","image":"/images/detail-color-sub-audit.jpg"},{"title":"Social Ads","desc":"Scroll-stopping motion ads optimized for Instagram, TikTok, and YouTube.","image":"/images/detail-color-sub-system.jpg"},{"title":"Explainer Videos","desc":"Complex products made simple — animated explainers that convert viewers into users.","image":"/images/detail-color-sub-calibration.jpg"},{"title":"Product Animation","desc":"3D and 2D product animations that show features no photo could capture.","image":"/images/detail-color-sub-guide.jpg"}],"processTitle":"How we work","processSteps":[{"step":"01","title":"Script","desc":"We write a script that hooks in 3 seconds and delivers your message in 30–90 seconds.","duration":"Week 1"},{"step":"02","title":"Storyboard","desc":"We create frame-by-frame storyboards and style frames for approval.","duration":"Week 1–2"},{"step":"03","title":"Animate","desc":"We design and animate every frame — typography, illustration, and 3D elements.","duration":"Week 2–4"},{"step":"04","title":"Deliver","desc":"We deliver in all formats — vertical, square, horizontal — ready for every platform.","image":"","duration":"Week 4–5"}],"processImage":"/images/detail-color-process.jpg","deliverablesTitle":"Deliverables & scope","deliverablesScope":"One motion graphics package: script, storyboard, animation, sound design, and delivery in 3 aspect ratios. Includes 2 rounds of revisions.","deliverablesStarting":"Starting from $5,000","deliverablesImage":"/images/detail-color-deliverables.jpg","relatedWork":[{"title":"Pulse Fintech","cat":"Brand film · 60s","image":"/images/detail-color-work-1.jpg"},{"title":"Lumen App","cat":"Explainer · 90s","image":"/images/detail-color-work-2.jpg"},{"title":"Vertex Labs","cat":"Social ads · 6 formats","image":"/images/detail-color-work-3.jpg"}],"caseStudyImage":"/images/detail-color-casestudy.jpg","caseStudyMetric":"3x engagement rate","caseStudyQuote":"Our social engagement tripled after we switched to their motion content. The brand film alone drove 40% of our Q4 signups.","caseStudyAuthor":"Omar Khalid, CMO at Pulse Fintech","faqTitle":"Frequently asked questions","faqs":[{"q":"What software do you use for motion graphics?","a":"After Effects for 2D animation, Blender and Cinema 4D for 3D, and Premiere Pro for editing. We deliver in any format you need — MP4, WebM, GIF, or Lottie."},{"q":"Can you create Lottie animations for our app?","a":"Yes. We export lightweight Lottie files that play natively in iOS, Android, and web — perfect for onboarding flows, loading states, and micro-interactions."},{"q":"Do you write the script or do we?","a":"We can do either. Most clients give us a brief and we write the script. We also work with your copywriter if you have one — we'll adapt their words into a visual storyboard."},{"q":"How many revisions are included?","a":"Two rounds of revisions are standard. We present storyboards before animation, so you approve the direction before we invest in motion. Additional revisions are billed at an hourly rate."},{"q":"Can you match our brand guidelines?","a":"Absolutely. We work from your brand kit — colors, typography, logo, tone — and extend it into motion. If you don't have motion guidelines, we'll create them as part of the project."},{"q":"What's the turnaround time?","a":"A 60-second explainer typically takes 3–4 weeks. Social ad packages (6–15 second spots) can be delivered in 1–2 weeks. Rush delivery is available for an additional fee."}],"relatedServices":["UI/UX Design","Digital Marketing","Web & App Development"]}}]}],["$L4"],"$L5"]}],"loading":null,"isPartial":false}
