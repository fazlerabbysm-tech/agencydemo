0:{"buildId":"PTWSWFlPIbEhrOk_o-gY1","rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"project":{"slug":"maison-noir","no":"02","title":"Maison Noir","subtitle":"Color protocol across 12 touchpoints for luxury fashion","heroImage":"/images/portfolio-maison-1.jpg","client":"Maison Noir","industry":"Luxury Fashion","year":"2025","services":["Color Standardization Protocol","E-commerce Catalog Optimization"],"serviceSlug":"color","overviewTitle":"One black, every surface","overviewText":["Maison Noir is a luxury fashion house where black isn't just a color — it's the brand. But their black looked different on Instagram, in their print lookbook, on their e-commerce store, and on the physical product. Customers were returning items because 'the color doesn't match the photo.' For a brand built on a single color, this was an existential problem.","We audited every place the brand color appeared — 12 touchpoints from social media to packaging to in-store displays. We built a master palette with Pantone references, ICC profiles for every output, and calibrated every monitor, printer, and photographer in the supply chain.","The result: color-related returns dropped 92% in the first quarter. The print lookbook now matches the website, which matches the product, which matches the packaging. Maison Noir's black is now the same black everywhere — exactly what a luxury brand demands."],"gallery":[{"src":"/images/portfolio-maison-2.jpg","alt":"Maison Noir color audit across touchpoints","caption":"Color audit — 12 touchpoints mapped"},{"src":"/images/portfolio-maison-3.jpg","alt":"Maison Noir Pantone color swatches","caption":"Master palette — Pantone-locked black"},{"src":"/images/portfolio-maison-4.jpg","alt":"Maison Noir ICC profile calibration","caption":"ICC profiles — screen to print to product"},{"src":"/images/portfolio-maison-5.jpg","alt":"Maison Noir monitor calibration setup","caption":"Calibration — every monitor, every printer"},{"src":"/images/portfolio-maison-6.jpg","alt":"Maison Noir print lookbook color matching","caption":"Print lookbook — matching the screen exactly"},{"src":"/images/portfolio-maison-7.jpg","alt":"Maison Noir e-commerce color consistency","caption":"E-commerce — product matches the physical item"},{"src":"/images/portfolio-maison-8.jpg","alt":"Maison Noir packaging color verification","caption":"Packaging — verified on the actual material"}],"credits":[{"role":"Color Director","name":"James Voss"},{"role":"Color Scientist","name":"Dr. Anika Patel"},{"role":"Print Specialist","name":"Tomas Reinhardt"},{"role":"Photographer","name":"Sofia Lindgren"}],"caseStudyLink":"#contact-page","relatedTitle":"Related projects","ctaTitle":"Want color that's consistent everywhere?"}}]}],[["$","script","script-0",{"src":"/_next/static/chunks/0b2f276026dfa5ac.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"loading":null,"isPartial":false}
