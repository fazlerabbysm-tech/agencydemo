6:["$","$Lf",null,{"children":["$","$L10",null,{"project":{"slug":"agency-collective","no":"04","title":"Agency Collective","subtitle":"Embedded white-label team for 200+ assets across 6 clients","heroImage":"/images/portfolio-agency-1.jpg","client":"Agency Collective","industry":"Creative Agency","year":"2024","services":["White-Label Agency Extension","E-commerce Catalog Optimization"],"serviceSlug":"whitelabel","overviewTitle":"An invisible studio behind a growing agency","overviewText":["Agency Collective was winning more pitches than they could staff. They had a small core team of strategists and creatives, but couldn't handle the production volume — design, development, and motion work for 6 concurrent clients. Hiring full-time senior staff was too risky with fluctuating project flow, and freelancers were inconsistent.","We embedded as their white-label production team. A dedicated producer learned their clients, their standards, and their workflow. We started with a 4-week pilot project, then scaled to handle design production, web development, and motion graphics across all 6 clients. Every deliverable shipped under Agency Collective's brand — their clients never knew we existed.","In 12 months, Agency Collective doubled their client base without hiring a single full-time person. They shipped 200+ assets through our team, won 3 new retainer clients, and their profit margins improved because they weren't carrying idle capacity between projects. We're now their permanent production backend."],"gallery":[{"src":"/images/portfolio-agency-2.jpg","alt":"Agency Collective design production workspace","caption":"Design production — brand systems and collateral"},{"src":"/images/portfolio-agency-3.jpg","alt":"Agency Collective web development builds","caption":"Web development — Next.js and Webflow builds"},{"src":"/images/portfolio-agency-4.jpg","alt":"Agency Collective motion graphics work","caption":"Motion graphics — social cutdowns and brand films"},{"src":"/images/portfolio-agency-5.jpg","alt":"Agency Collective client dashboard and workflow","caption":"Workflow — integrated into their PM tools"},{"src":"/images/portfolio-agency-6.jpg","alt":"Agency Collective multi-client asset management","caption":"Asset management — 6 clients, one system"},{"src":"/images/portfolio-agency-7.jpg","alt":"Agency Collective quality assurance process","caption":"Quality assurance — calibrated to their standards"},{"src":"/images/portfolio-agency-8.jpg","alt":"Agency Collective final client deliverables","caption":"Final delivery — under their brand, not ours"}],"credits":[{"role":"Producer","name":"Sarah Lindgren"},{"role":"Design Lead","name":"Alex Morgan"},{"role":"Dev Lead","name":"Raj Kumar"},{"role":"Motion Lead","name":"Nina Petrov"}],"caseStudyLink":"#contact-page","relatedTitle":"Related projects","ctaTitle":"Want production capacity without the overhead?"}}]}]
