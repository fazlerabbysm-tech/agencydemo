6:["$","$Lf",null,{"children":["$","$L10",null,{"project":{"slug":"echo-motors","no":"03","title":"ECHO Motors","subtitle":"CGI launch film for an EV that didn't exist yet","heroImage":"/images/portfolio-echo-1.jpg","client":"ECHO Motors","industry":"Automotive / EV","year":"2024","services":["Virtual Production & CGI Studio","Color Standardization Protocol"],"serviceSlug":"cgi","overviewTitle":"A car launch with no physical car","overviewText":["ECHO Motors was launching their first electric vehicle, but the physical prototype wasn't ready. The marketing team had 8 weeks to produce a launch film, and there was no car to film. Traditional production would have meant waiting months for the prototype, then scheduling a shoot with a crew, location, and weather risk.","We built the entire car in CGI — a photoreal 3D model with every detail, from the headlights to the stitching on the seats. Using our LED volume virtual production stage, we shot real-time environments: desert highways, city nights, mountain passes. The car was composited into every scene in real-time.","The launch film was delivered on time, at 60% of the cost of a physical shoot, with zero weather risk. When the physical car was finally revealed at the auto show, customers said the CGI looked 'exactly like the real thing' — which was the point. ECHO now uses the 3D assets for every campaign, AR experiences, and their website configurator."],"gallery":[{"src":"/images/portfolio-echo-2.jpg","alt":"ECHO Motors CGI car 3D model wireframe","caption":"3D model — wireframe to photoreal"},{"src":"/images/portfolio-echo-3.jpg","alt":"ECHO Motors virtual production LED volume stage","caption":"LED volume — real-time environments"},{"src":"/images/portfolio-echo-4.jpg","alt":"ECHO Motors CGI desert highway scene","caption":"Desert highway — composited in real-time"},{"src":"/images/portfolio-echo-5.jpg","alt":"ECHO Motors CGI city night scene","caption":"City night — neon reflections on the car"},{"src":"/images/portfolio-echo-6.jpg","alt":"ECHO Motors CGI detail shots","caption":"Detail shots — headlights, wheels, interior"},{"src":"/images/portfolio-echo-7.jpg","alt":"ECHO Motors color grading suite","caption":"Color grade — matching the brand palette"},{"src":"/images/portfolio-echo-8.jpg","alt":"ECHO Motors final launch film frame","caption":"Final frame — launched on time, under budget"}],"credits":[{"role":"CGI Director","name":"Daniel Park"},{"role":"3D Lead","name":"Yuki Tanaka"},{"role":"Virtual Production","name":"Marcus Brandt"},{"role":"Colorist","name":"Elena Rossi"}],"caseStudyLink":"#contact-page","relatedTitle":"Related projects","ctaTitle":"Want to launch without a physical product?"}}]}]
