0:{"buildId":"wdgP4DxE2W0MiXmjBnorC","rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"service":{"slug":"digital-marketing","no":"03","name":"Digital Marketing","heroTitle":"Growth, engineered.","heroOutcome":"We build and run integrated digital marketing campaigns that drive measurable business growth. SEO, paid media, social, content, and analytics — all working together to acquire, engage, and retain customers.","bestFor":["Growing startups","E-commerce brands","B2B companies"],"notSureText":"Not sure it fits? Talk to us","problemTitle":"Your marketing isn't driving growth","problemPoints":["You're spending on ads but can't tell what's actually working","Your SEO traffic is flat or declining","Social media takes hours but produces no leads","Your email list isn't growing and open rates are dropping","You have data but no strategy — dashboards without decisions"],"problemImage":"/images/detail-cgi-problem.jpg","includedTitle":"What's included","subServices":[{"title":"SEO & Content","desc":"Technical SEO, keyword strategy, and content that ranks — organic growth that compounds.","image":"/images/detail-cgi-sub-virtual.jpg"},{"title":"Paid Media","desc":"Google, Meta, and TikTok ads managed and optimized for ROAS, not just clicks.","image":"/images/detail-cgi-sub-product.jpg"},{"title":"Social Media","desc":"Organic social strategy, content calendars, and community management that builds brand.","image":"/images/detail-cgi-sub-mocap.jpg"},{"title":"Analytics & CRO","desc":"Conversion tracking, A/B testing, and funnel optimization — data-driven decisions.","image":"/images/detail-cgi-sub-finish.jpg"}],"processTitle":"How we work","processSteps":[{"step":"01","title":"Audit","desc":"We audit your current marketing — channels, spend, conversion data, and competitor positioning.","duration":"Week 1"},{"step":"02","title":"Strategy","desc":"We build a 90-day marketing plan with channel mix, budget allocation, and KPIs.","duration":"Week 1–2"},{"step":"03","title":"Execute","desc":"We launch campaigns, create content, and manage ads across all channels.","duration":"Week 2+"},{"step":"04","title":"Optimize","desc":"Weekly reporting, A/B testing, and continuous optimization based on real data.","duration":"Ongoing"}],"processImage":"/images/detail-cgi-process.jpg","deliverablesTitle":"Deliverables & scope","deliverablesScope":"Full digital marketing management: strategy, SEO, paid media (up to $50K/month spend), social media, content, and monthly reporting. Minimum 3-month engagement.","deliverablesStarting":"Starting from $4,000/month","deliverablesImage":"/images/detail-cgi-deliverables.jpg","relatedWork":[{"title":"Glow Skincare","cat":"D2C · 3x ROAS","image":"/images/detail-cgi-work-1.jpg"},{"title":"TaskFlow","cat":"B2B SaaS · 5x MQL growth","image":"/images/detail-cgi-work-2.jpg"},{"title":"Nomad Cafe","cat":"Local · 200% foot traffic","image":"/images/detail-cgi-work-3.jpg"}],"caseStudyImage":"/images/detail-cgi-casestudy.jpg","caseStudyMetric":"5x return on ad spend","caseStudyQuote":"Within 4 months, Katella took us from burning money on ads to a 5x ROAS. Their data-driven approach replaced guesswork with strategy.","caseStudyAuthor":"Fatima Al-Sayed, Founder at Glow Skincare","faqTitle":"Frequently asked questions","faqs":[{"q":"Do you require a minimum ad spend budget?","a":"We recommend a minimum of $5,000/month in ad spend for paid media management. Below that, organic channels (SEO, social, content) are more cost-effective. We'll tell you honestly which channels make sense for your budget."},{"q":"How soon will we see results?","a":"Paid media can show results within 2–4 weeks. SEO typically takes 3–6 months for meaningful traffic gains. Social and content compound over 6–12 months. We set realistic expectations in our strategy document."},{"q":"Do you work with our existing marketing team?","a":"Yes. We can act as your entire marketing department or extend your in-house team. We've worked with solo founders, 10-person marketing teams, and everything in between."},{"q":"What platforms do you manage ads on?","a":"Google Ads (Search, Display, YouTube), Meta (Facebook, Instagram), TikTok, LinkedIn, and X. We also handle programmatic display through Google Display Network."},{"q":"How do you report on performance?","a":"Monthly performance reports with channel-level breakdowns, ROAS, CPA, and trend analysis. We also provide a live dashboard (Google Looker or GA4) so you can check numbers anytime."},{"q":"Can you help with email marketing?","a":"Yes. We design and write email campaigns, manage automation flows (Klaviyo, Mailchimp, HubSpot), and optimize deliverability and open rates. Email is one of the highest-ROI channels we manage."}],"relatedServices":["UI/UX Design","Motion Graphics","Web & App Development"]}}]}],["$L4"],"$L5"]}],"loading":null,"isPartial":false}
