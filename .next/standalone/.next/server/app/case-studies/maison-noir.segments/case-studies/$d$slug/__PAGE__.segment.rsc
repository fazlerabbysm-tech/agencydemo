0:{"buildId":"PTWSWFlPIbEhrOk_o-gY1","rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"caseStudy":{"slug":"maison-noir","title":"Maison Noir: 92% fewer color returns","clientLogo":"/images/casestudy-maison-logo.png","clientName":"Maison Noir","metrics":[{"label":"Color returns","value":"-92%"},{"label":"Touchpoints synced","value":"12"},{"label":"Monitors calibrated","value":"14"},{"label":"Brand consistency","value":"100%"}],"ctaSticky":"Get results like this","snapshot":{"client":"Maison Noir","industry":"Luxury Fashion","services":["Color Standardization Protocol","E-commerce Catalog Optimization"],"timeline":"3 weeks · 2025"},"serviceSlug":"color","challengeTitle":"A luxury brand built on one color — that looked different everywhere","challengeText":["Maison Noir is a luxury fashion house where black isn't just a color — it's the entire brand identity. But their black looked different on Instagram, in their print lookbook, on their e-commerce store, and on the physical product.","Customers were returning items because 'the color doesn't match the photo.' For a brand built on a single color, this was an existential problem. Their creative team was spending 15+ hours per week color-correcting images in Photoshop, trying to make everything match.","They had 5 'official' brand color files, and no one on the team knew which one was current. Every new photographer and printer delivered a slightly different shade of black."],"challengeImage":"/images/casestudy-maison-challenge.jpg","approachTitle":"One source of truth, every surface","approachText":["We audited every place the brand color appeared — 12 touchpoints from social media to packaging to in-store displays. We collected physical samples, print proofs, and digital files to map the full inconsistency.","We built a master palette with Pantone references, ICC profiles for every output (screen, print, fabric, packaging), and calibrated every monitor, printer, and photographer in the supply chain.","The key decision was to involve the print partner and the fabric supplier from day one. Color on recycled board behaves differently from color on silk — we tested the master palette on every material before locking it."],"approachImage":"/images/casestudy-maison-approach.jpg","shippedTitle":"What we shipped","shippedIntro":"A complete color standardization protocol — master palette, ICC profiles, calibrated hardware, and a living brand color guide.","shipItems":[{"title":"Master color palette","desc":"Pantone-locked references for every brand color, with CMYK, RGB, and hex values for every output surface.","image":"/images/casestudy-maison-ship-1.jpg"},{"title":"ICC profiles + calibration","desc":"14 monitors calibrated, ICC profiles for 3 printers, and a calibration schedule to prevent drift.","image":"/images/casestudy-maison-ship-2.jpg"},{"title":"Brand color guide","desc":"A living document with usage rules, test files, and a verification workflow for every new asset.","image":"/images/casestudy-maison-ship-3.jpg"}],"liveProjectUrl":"https://maisonnoir.example.com","resultsTitle":"The numbers, before and after","resultsMetrics":[{"label":"Color returns","value":"18% → 1.4%"},{"label":"Color-correcting hours","value":"15h/wk → 0"},{"label":"Touchpoints consistent","value":"3 / 12 → 12 / 12"},{"label":"Customer complaints","value":"-94%"}],"resultsImage":"/images/casestudy-maison-results.jpg","testimonial":{"quote":"Before, every product photo looked slightly different and customers complained. After the protocol, color-related returns dropped 92% in the first quarter. Our black is now the same black everywhere — exactly what a luxury brand demands.","name":"James Voss","role":"Creative Director, Maison Noir"},"learningsTitle":"What we'd repeat or change","learningsText":["We'd repeat involving the print partner and fabric supplier from day one. Testing the palette on actual materials — not just screens — was the difference between a protocol that works and one that doesn't.","We'd add a quarterly re-calibration checkpoint sooner. Monitors drift faster than expected, and the first month had a few close calls before we set up the schedule."],"servicesUsed":["Color Standardization Protocol","E-commerce Catalog Optimization"],"relatedTitle":"Related case studies","ctaTitle":"Want results like this?"}}]}],["$L4"],"$L5"]}],"loading":null,"isPartial":false}
