0:{"buildId":"PTWSWFlPIbEhrOk_o-gY1","rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"caseStudy":{"slug":"agency-collective","title":"Agency Collective: 3x projects, 0 hires","clientLogo":"/images/casestudy-agency-logo.png","clientName":"Agency Collective","metrics":[{"label":"Projects shipped","value":"3x"},{"label":"New hires","value":"0"},{"label":"Clients added","value":"6 → 12"},{"label":"Margin improvement","value":"+22%"}],"ctaSticky":"Get results like this","snapshot":{"client":"Agency Collective","industry":"Creative Agency","services":["White-Label Agency Extension","E-commerce Catalog Optimization"],"timeline":"12 months · 2024-2025"},"serviceSlug":"whitelabel","challengeTitle":"Winning more pitches than they could staff","challengeText":["Agency Collective was winning more pitches than they could staff. They had a small core team of strategists and creatives, but couldn't handle the production volume — design, development, and motion work for 6 concurrent clients.","Hiring full-time senior staff was too risky with fluctuating project flow. They'd tried freelancers, but the quality was inconsistent and managing them was a full-time job in itself.","They were turning down work — 4 pitches in the last quarter were declined because they couldn't guarantee delivery. Their reputation was at risk."],"challengeImage":"/images/casestudy-agency-challenge.jpg","approachTitle":"Embed, don't outsource","approachText":["We embedded as their white-label production team. A dedicated producer learned their clients, their standards, and their workflow. We started with a 4-week pilot project to calibrate quality and communication.","The key decision was to act as an extension of their team, not a vendor. We used their project management tools, their templates, their review process. By the end of the pilot, we worked the way they worked.","We scaled from 1 to 3 specialists (design, dev, motion) allocated to their projects, with the producer as the single point of contact. Every deliverable shipped under Agency Collective's brand."],"approachImage":"/images/casestudy-agency-approach.jpg","shippedTitle":"What we shipped","shippedIntro":"200+ assets across 6 clients — design, development, and motion work, all produced under Agency Collective's brand.","shipItems":[{"title":"Design production","desc":"Brand systems, marketing collateral, and social assets for 6 concurrent clients.","image":"/images/casestudy-agency-ship-1.jpg"},{"title":"Web development","desc":"Next.js and Webflow builds — responsive, accessible, ready to hand to clients.","image":"/images/casestudy-agency-ship-2.jpg"},{"title":"Motion & video","desc":"Brand films, social cutdowns, and motion graphics — edited and color-graded.","image":"/images/casestudy-agency-ship-3.jpg"}],"liveProjectUrl":"https://agencycollective.example.com","resultsTitle":"The numbers, before and after","resultsMetrics":[{"label":"Projects shipped","value":"68 → 204"},{"label":"Active clients","value":"6 → 12"},{"label":"Full-time hires","value":"0"},{"label":"Profit margin","value":"34% → 56%"}],"resultsImage":"/images/casestudy-agency-results.jpg","testimonial":{"quote":"We doubled our client base in a year without hiring a single full-time person. Their team is our team — our clients don't even know they exist. The margin improvement paid for the retainer in the first month.","name":"Sarah Lindgren","role":"Partner, Agency Collective"},"learningsTitle":"What we'd repeat or change","learningsText":["We'd repeat the pilot project approach. Calibrating to their standards before scaling was essential — by week 4, we were indistinguishable from their in-house team.","We'd add a quarterly review process sooner. The first 6 months went well, but a formal check-in at month 3 would have caught a few workflow inefficiencies earlier."],"servicesUsed":["White-Label Agency Extension","E-commerce Catalog Optimization"],"relatedTitle":"Related case studies","ctaTitle":"Want results like this?"}}]}],["$L4"],"$L5"]}],"loading":null,"isPartial":false}
