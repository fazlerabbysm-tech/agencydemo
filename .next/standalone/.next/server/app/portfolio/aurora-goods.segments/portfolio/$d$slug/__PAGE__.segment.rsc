0:{"buildId":"wdgP4DxE2W0MiXmjBnorC","rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"project":{"slug":"aurora-goods","no":"01","title":"Aurora Goods","subtitle":"Catalog system for 500 SKUs of D2C skincare","heroImage":"/images/portfolio-aurora-1.jpg","client":"Aurora Goods","industry":"D2C Skincare","year":"2025","services":["UI/UX Design","Digital Marketing"],"serviceSlug":"ui-ux","overviewTitle":"A catalog that scaled with the brand","overviewText":["Aurora Goods came to us with a catalog of 500 SKUs spread across three marketplaces and their own DTC store. Every product photo was shot by a different photographer, in different lighting, with different backgrounds. The result was a catalog that looked chaotic and converted poorly — customers couldn't tell if two products were from the same brand.","We rebuilt the entire catalog from scratch. A 200-square-meter studio was set up with locked lighting, a consistent style guide, and a retouching pipeline that could handle 50 SKUs per week. Every product was re-photographed on white, lifestyle, and detail angles, then retouched to a single color standard.","Within two months of launch, Aurora's conversion rate was up 34%, their ad spend was working harder, and their customer service tickets about 'product doesn't match photo' had dropped to near zero. The catalog system we built is now used for every new product launch — no photographer or retoucher needed from their side."],"gallery":[{"src":"/images/portfolio-aurora-2.jpg","alt":"Aurora Goods product photography studio setup","caption":"Studio setup — locked lighting for 500 SKUs"},{"src":"/images/portfolio-aurora-3.jpg","alt":"Aurora Goods white background product shots","caption":"White background shots — consistent across every SKU"},{"src":"/images/portfolio-aurora-4.jpg","alt":"Aurora Goods lifestyle product photography","caption":"Lifestyle shots — bathroom and vanity scenes"},{"src":"/images/portfolio-aurora-5.jpg","alt":"Aurora Goods detail and macro photography","caption":"Detail shots — texture and packaging close-ups"},{"src":"/images/portfolio-aurora-6.jpg","alt":"Aurora Goods catalog layout and listing design","caption":"Catalog layout — optimized for mobile scroll"},{"src":"/images/portfolio-aurora-7.jpg","alt":"Aurora Goods color correction and retouching workflow","caption":"Retouching workflow — one click, 500 SKUs"},{"src":"/images/portfolio-aurora-8.jpg","alt":"Aurora Goods final marketplace listing","caption":"Final listing — Amazon, Shopify, and DTC synced"}],"credits":[{"role":"Creative Director","name":"Maria Chen"},{"role":"Lead Photographer","name":"David Park"},{"role":"Retoucher","name":"Lena Voss"},{"role":"Copywriter","name":"James Holloway"}],"caseStudyLink":"#contact-page","relatedTitle":"Related projects","ctaTitle":"Want a catalog that sells like this?"}}]}],[["$","script","script-0",{"src":"/_next/static/chunks/5cc6e072c02aa913.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"loading":null,"isPartial":false}
